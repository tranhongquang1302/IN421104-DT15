@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="login-grid">
    <div class="login-intro">
        <img class="login-photo" src="~/images/language-classroom.jpg" alt="" asp-append-version="true" fetchpriority="high" />
        <div class="login-intro-copy">
            <h1>Quản lý trung tâm ngoại ngữ</h1>
            <p>Từ ghi danh, học phí đến cấp chứng chỉ.</p>
        </div>
    </div>
    <div class="login-form">
        <div class="form-heading">
            <h2>Đăng nhập</h2>
            <p class="muted">Dùng tài khoản nhân viên để tiếp tục.</p>
        </div>
        <form method="post" class="form-stack">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" required />
                <span asp-validation-for="Input.Email" class="validation"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">Mật khẩu</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
                <span asp-validation-for="Input.Password" class="validation"></span>
            </div>
            <button type="submit" class="button primary">Đăng nhập <span aria-hidden="true">→</span></button>
        </form>
    </div>
</section>
