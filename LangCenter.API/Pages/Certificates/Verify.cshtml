@page "/certificates/verify/{lookupCode?}"
@model LangCenter.API.Pages.Certificates.VerifyModel
@{
    ViewData["Title"] = "Tra cứu chứng chỉ";
}
<section class="verification-page">
    <header class="page-heading"><div><h1>Tra cứu chứng chỉ</h1><p>Quét mã QR trên chứng chỉ hoặc nhập mã tra cứu.</p></div></header>
    <form method="get" asp-page="/Certificates/Verify" asp-route-lookupCode="" class="panel lookup-form" aria-label="Tìm chứng chỉ">
        <div class="field">
            <label for="code">Mã tra cứu</label>
            <input id="code" name="code" value="@Model.Code" maxlength="32" autocomplete="off" required />
        </div>
        <button type="submit" class="button primary">Tra cứu</button>
    </form>
    @if (Model.Certificate is { } certificate)
    {
        <article class="panel verified">
            <span class="badge success">Đã xác thực</span>
            <h2>@certificate.StudentName</h2>
            <dl class="details"><dt>Lớp học</dt><dd>@certificate.ClassName</dd><dt>Ngày cấp</dt><dd>@certificate.IssuedAt.ToString("dd/MM/yyyy")</dd></dl>
        </article>
    }
    else if (Model.Code is not null)
    {
        <div class="notice warning" role="status">Không tìm thấy chứng chỉ với mã này.</div>
    }
</section>
